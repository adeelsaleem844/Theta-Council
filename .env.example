# ─── Alpaca (REQUIRED) ───────────────────────────────────────────────────────
# Create a BRAND-NEW paper account for the hackathon, set balance to $100,000
# and enable Options Trading Level 3 (needed for spreads / iron condors).
ALPACA_API_KEY=PK_your_key_here
ALPACA_SECRET_KEY=your_secret_here
ALPACA_PAPER_TRADE=true
ALPACA_ACCOUNT_ID=your-paper-account-uuid   # printed in submission; also auto-detected

# Data feeds. Free plan -> iex / indicative.  Algo Trader Plus -> sip / opra.
ALPACA_STOCK_FEED=iex
ALPACA_OPTION_FEED=indicative

# ─── Transport router ────────────────────────────────────────────────────────
# Order in which Theta Council reaches Alpaca. Every call logs which one served
# it, so the audit trail proves CLI / MCP usage.  cli -> mcp -> rest
TRANSPORT_ORDER=cli,mcp,rest
ALPACA_CLI_BIN=alpaca
ALPACA_MCP_CMD=uvx alpaca-mcp-server

# ─── LLM reasoning layer (Featherless AI = hackathon partner) ────────────────
# Leave LLM_PROVIDER=none to run the desk fully deterministically.
LLM_PROVIDER=featherless               # featherless | anthropic | none
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=meta-llama/Llama-3.3-70B-Instruct
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ─── Risk budget (all enforced in code, AFTER the LLM speaks) ───────────────
MAX_RISK_PER_TRADE_PCT=1.5
MAX_DEPLOYED_RISK_PCT=12
MAX_CONCURRENT_POSITIONS=6
MAX_POSITIONS_PER_UNDERLYING=2
MAX_NET_DELTA_PER_100K=150
DAILY_LOSS_KILL_PCT=2.5
DRAWDOWN_KILL_PCT=8.0
MIN_CREDIT_TO_WIDTH=0.15
MIN_OPEN_INTEREST=250
MAX_SPREAD_PCT_OF_MID=12
DTE_MIN=14
DTE_MAX=45
TAKE_PROFIT_PCT=55
STOP_LOSS_MULT=2.0
TIME_EXIT_DTE=7
DELTA_BREACH=0.40
UNIVERSE=SPY,QQQ,IWM,AAPL,MSFT,NVDA,AMD,META,GOOGL,AMZN
